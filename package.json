{
  "name": "@gray0128/pi-cliproxyapi-provider",
  "version": "0.1.1",
  "description": "Pi provider for a local or remote CLIProxyAPI OpenAI-compatible endpoint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gray0128/cap2pi.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "cliproxyapi",
    "model-provider"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  }
}
